{"ast":null,"code":"import { ref } from 'vue';\nimport { useBlockchainStore } from '@/store';\nimport WalletList from '@/components/WalletList.vue';\nimport BlockList from '@/components/BlockList.vue';\nexport default {\n  components: {\n    WalletList,\n    BlockList\n  },\n  setup() {\n    const store = useBlockchainStore();\n    const sender = ref('');\n    const receiver = ref('');\n    const amount = ref(null);\n    const submitTx = async () => {\n      await store.submitTransaction(sender.value, receiver.value, amount.value);\n      alert('Transaction submitted!');\n    };\n    const mine = async () => {\n      await store.mineBlock();\n      alert('Block mined!');\n    };\n    return {\n      store,\n      sender,\n      receiver,\n      amount,\n      submitTx,\n      mine\n    };\n  }\n};","map":{"version":3,"names":["ref","useBlockchainStore","WalletList","BlockList","components","setup","store","sender","receiver","amount","submitTx","submitTransaction","value","alert","mine","mineBlock"],"sources":["/Users/benwo/Desktop/code/my-vue-app/src/views/HomeView.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>Vue + Go Blockchain</h1>\n\n    <!-- Transaction Form -->\n    <form @submit.prevent=\"submitTx\">\n      <input v-model=\"sender\" placeholder=\"Sender\" />\n      <input v-model=\"receiver\" placeholder=\"Receiver\" />\n      <input v-model.number=\"amount\" type=\"number\" placeholder=\"Amount\" />\n      <button>Submit</button>\n    </form>\n\n    <button @click=\"mine\">Mine</button>\n    <button @click=\"store.fetchWallets\">Refresh Wallets</button>\n    <button @click=\"store.fetchBlockchain\">View Blockchain</button>\n\n    <!-- Component usage -->\n    <WalletList :wallets=\"store.wallets\" />\n    <BlockList :blockchain=\"store.blockchain\" />\n  </div>\n</template>\n\n<script>\nimport { ref } from 'vue';\nimport { useBlockchainStore } from '@/store';\nimport WalletList from '@/components/WalletList.vue';\nimport BlockList from '@/components/BlockList.vue';\n\nexport default {\n  components: { WalletList, BlockList },\n  setup() {\n    const store = useBlockchainStore();\n    const sender = ref('');\n    const receiver = ref('');\n    const amount = ref(null);\n\n    const submitTx = async () => {\n      await store.submitTransaction(sender.value, receiver.value, amount.value);\n      alert('Transaction submitted!');\n    };\n\n    const mine = async () => {\n      await store.mineBlock();\n      alert('Block mined!');\n    };\n\n    return {\n      store,\n      sender,\n      receiver,\n      amount,\n      submitTx,\n      mine\n    };\n  }\n};\n</script>\n"],"mappings":"AAuBA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,kBAAiB,QAAS,SAAS;AAC5C,OAAOC,UAAS,MAAO,6BAA6B;AACpD,OAAOC,SAAQ,MAAO,4BAA4B;AAElD,eAAe;EACbC,UAAU,EAAE;IAAEF,UAAU;IAAEC;EAAU,CAAC;EACrCE,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,kBAAkB,CAAC,CAAC;IAClC,MAAMM,MAAK,GAAIP,GAAG,CAAC,EAAE,CAAC;IACtB,MAAMQ,QAAO,GAAIR,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMS,MAAK,GAAIT,GAAG,CAAC,IAAI,CAAC;IAExB,MAAMU,QAAO,GAAI,MAAAA,CAAA,KAAY;MAC3B,MAAMJ,KAAK,CAACK,iBAAiB,CAACJ,MAAM,CAACK,KAAK,EAAEJ,QAAQ,CAACI,KAAK,EAAEH,MAAM,CAACG,KAAK,CAAC;MACzEC,KAAK,CAAC,wBAAwB,CAAC;IACjC,CAAC;IAED,MAAMC,IAAG,GAAI,MAAAA,CAAA,KAAY;MACvB,MAAMR,KAAK,CAACS,SAAS,CAAC,CAAC;MACvBF,KAAK,CAAC,cAAc,CAAC;IACvB,CAAC;IAED,OAAO;MACLP,KAAK;MACLC,MAAM;MACNC,QAAQ;MACRC,MAAM;MACNC,QAAQ;MACRI;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
{"ast":null,"code":"export default {\n  data() {\n    return {\n      sender: \"\",\n      receiver: \"\",\n      amount: null,\n      wallets: {},\n      blockchain: []\n    };\n  },\n  methods: {\n    async submitTransaction() {\n      await fetch(\"http://localhost:8081/transaction\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\"\n        },\n        body: JSON.stringify({\n          sender: this.sender,\n          receiver: this.receiver,\n          amount: this.amount\n        })\n      });\n      alert(\"Transaction submitted!\");\n    },\n    async mine() {\n      await fetch(\"http://localhost:8081/mine\");\n      alert(\"Block mined!\");\n    },\n    async loadWallets() {\n      const res = await fetch(\"http://localhost:8081/wallets\");\n      this.wallets = await res.json();\n    },\n    async loadBlockchain() {\n      const res = await fetch(\"http://localhost:8081/blockchain\");\n      this.blockchain = await res.json();\n    }\n  }\n};","map":{"version":3,"names":["data","sender","receiver","amount","wallets","blockchain","methods","submitTransaction","fetch","method","headers","body","JSON","stringify","alert","mine","loadWallets","res","json","loadBlockchain"],"sources":["/Users/benwo/Desktop/code/my-vue-app/src/App.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>Vue + Go Blockchain</h1>\n\n    <form @submit.prevent=\"submitTransaction\">\n      <input v-model=\"sender\" placeholder=\"Sender\" />\n      <input v-model=\"receiver\" placeholder=\"Receiver\" />\n      <input v-model.number=\"amount\" placeholder=\"Amount\" type=\"number\" />\n      <button>Submit Transaction</button>\n    </form>\n\n    <button @click=\"mine\">Mine Block</button>\n    <button @click=\"loadWallets\">Refresh Wallets</button>\n    <button @click=\"loadBlockchain\">View Blockchain</button>\n\n    <h2>Wallets</h2>\n    <ul>\n      <li v-for=\"(wallet, address) in wallets\" :key=\"address\">\n        {{ address }}: {{ wallet.balance }}\n      </li>\n    </ul>\n\n    <h2>Blockchain</h2>\n    <div v-for=\"block in blockchain\" :key=\"block.hash\">\n      <p>Block #{{ block.index }} - Hash: {{ block.hash }}</p>\n      <p>Transactions: {{ block.transactions.length }}</p>\n      <hr />\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      sender: \"\",\n      receiver: \"\",\n      amount: null,\n      wallets: {},\n      blockchain: []\n    };\n  },\n  methods: {\n    async submitTransaction() {\n      await fetch(\"http://localhost:8081/transaction\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          sender: this.sender,\n          receiver: this.receiver,\n          amount: this.amount\n        })\n      });\n      alert(\"Transaction submitted!\");\n    },\n    async mine() {\n      await fetch(\"http://localhost:8081/mine\");\n      alert(\"Block mined!\");\n    },\n    async loadWallets() {\n      const res = await fetch(\"http://localhost:8081/wallets\");\n      this.wallets = await res.json();\n    },\n    async loadBlockchain() {\n      const res = await fetch(\"http://localhost:8081/blockchain\");\n      this.blockchain = await res.json();\n    }\n  }\n};\n</script>\n"],"mappings":"AAgCA,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,EAAE;MACVC,QAAQ,EAAE,EAAE;MACZC,MAAM,EAAE,IAAI;MACZC,OAAO,EAAE,CAAC,CAAC;MACXC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,iBAAiBA,CAAA,EAAG;MACxB,MAAMC,KAAK,CAAC,mCAAmC,EAAE;QAC/CC,MAAM,EAAE,MAAM;QACdC,OAAO,EAAE;UAAE,cAAc,EAAE;QAAmB,CAAC;QAC/CC,IAAI,EAAEC,IAAI,CAACC,SAAS,CAAC;UACnBZ,MAAM,EAAE,IAAI,CAACA,MAAM;UACnBC,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,MAAM,EAAE,IAAI,CAACA;QACf,CAAC;MACH,CAAC,CAAC;MACFW,KAAK,CAAC,wBAAwB,CAAC;IACjC,CAAC;IACD,MAAMC,IAAIA,CAAA,EAAG;MACX,MAAMP,KAAK,CAAC,4BAA4B,CAAC;MACzCM,KAAK,CAAC,cAAc,CAAC;IACvB,CAAC;IACD,MAAME,WAAWA,CAAA,EAAG;MAClB,MAAMC,GAAE,GAAI,MAAMT,KAAK,CAAC,+BAA+B,C
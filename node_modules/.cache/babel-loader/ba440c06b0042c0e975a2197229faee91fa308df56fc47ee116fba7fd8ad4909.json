{"ast":null,"code":"export default {\n  props: {\n    blockchain: Array\n  }\n};","map":{"version":3,"names":["props","blockchain","Array"],"sources":["/Users/benwo/Desktop/code/blockchain-project-vue/src/components/BlockList.vue"],"sourcesContent":["<template>\n    <div>\n      <div v-for=\"block in blockchain\" :key=\"block.hash\" class=\"block\">\n        <p><strong>Block #{{ block.index }}</strong></p>\n        <p>Hash: {{ block.hash }}</p>\n        <p>Prev: {{ block.prevHash }}</p>\n        <p>Tx Count: {{ block.transactions?.length || 0 }}</p>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  export default {\n    props: {\n      blockchain: Array\n    }\n  };\n  </script>\n  \n  <style scoped>\n  h2 {\n    color: #40c4ff;\n  }\n  \n  .block {\n    border: 1px solid #444;\n    border-left: 6px solid #40c4ff;\n    padding: 1rem;\n    margin-bottom: 1rem;\n    border-radius: 6px;\n    background-color: #1e1e1e;\n    transition: transform 0.3s ease;\n    word-wrap: break-word;\n    overflow-wrap: break-word;\n    white-space: normal;\n  }\n  \n  .block:hover {\n    transform: scale(1.01);\n  }\n  </style>\n  "],"mappings":"AAYE,eAAe;EACbA,KAAK,EAAE;IACLC,UAAU,EAAEC;EACd;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
{"ast":null,"code":"export default {\n  props: {\n    blockchain: Array\n  }\n};","map":{"version":3,"names":["props","blockchain","Array"],"sources":["/Users/benwo/Desktop/code/my-vue-app/src/components/BlockList.vue"],"sourcesContent":["<template>\n    <div>\n      <h2>📦 Blockchain</h2>\n      <div v-for=\"block in blockchain\" :key=\"block.hash\" class=\"block\">\n        <p><strong>Block #{{ block.index }}</strong></p>\n        <p>Hash: {{ block.hash }}</p>\n        <p>Prev: {{ block.prevHash }}</p>\n        <p>Tx Count: {{ block.transactions?.length || 0 }}</p>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  export default {\n    props: {\n      blockchain: Array\n    }\n  };\n  </script>\n  \n  <style scoped>\n  .block {\n    border: 1px solid #ccc;\n    border-left: 6px solid #4CAF50;\n    padding: 1rem;\n    margin-bottom: 1rem;\n    border-radius: 4px;\n    background-color: #f9f9f9;\n  }\n  </style>\n  "],"mappings":"AAaE,eAAe;EACbA,KAAK,EAAE;IACLC,UAAU,EAAEC;EACd;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
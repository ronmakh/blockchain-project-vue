{"ast":null,"code":"import { ref } from 'vue';\nimport { useBlockchainStore } from '@/store';\nimport WalletList from '@/components/WalletList.vue';\nimport BlockList from '@/components/BlockList.vue';\nexport default {\n  components: {\n    WalletList,\n    BlockList\n  },\n  setup() {\n    const store = useBlockchainStore();\n    const sender = ref('');\n    const receiver = ref('');\n    const amount = ref(null);\n    const submitTx = async () => {\n      await store.submitTransaction(sender.value, receiver.value, amount.value);\n      alert('Transaction submitted!');\n    };\n    const mine = async () => {\n      await store.mineBlock();\n      alert('Block mined!');\n    };\n    return {\n      store,\n      sender,\n      receiver,\n      amount,\n      submitTx,\n      mine\n    };\n  }\n};","map":{"version":3,"names":["ref","useBlockchainStore","WalletList","BlockList","components","setup","store","sender","receiver","amount","submitTx","submitTransaction","value","alert","mine","mineBlock"],"sources":["/Users/benwo/Desktop/code/my-vue-app/src/views/HomeView.vue"],"sourcesContent":["<template>\n  <div class=\"container\">\n    <h1>🚀 Vue + Go Blockchain Explorer</h1>\n\n    <form class=\"form\" @submit.prevent=\"submitTx\">\n      <input v-model=\"sender\" placeholder=\"Sender\" />\n      <input v-model=\"receiver\" placeholder=\"Receiver\" />\n      <input v-model.number=\"amount\" type=\"number\" placeholder=\"Amount\" />\n      <button>Submit Transaction</button>\n    </form>\n\n    <div class=\"buttons\">\n      <button @click=\"mine\">⛏️ Mine Block</button>\n      <button @click=\"store.fetchWallets\">🔄 Refresh Wallets</button>\n      <button @click=\"store.fetchBlockchain\">📜 View Blockchain</button>\n    </div>\n\n    <div class=\"lists\">\n      <WalletList :wallets=\"store.wallets\" />\n      <BlockList :blockchain=\"store.blockchain\" />\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref } from 'vue';\nimport { useBlockchainStore } from '@/store';\nimport WalletList from '@/components/WalletList.vue';\nimport BlockList from '@/components/BlockList.vue';\n\nexport default {\n  components: { WalletList, BlockList },\n  setup() {\n    const store = useBlockchainStore();\n    const sender = ref('');\n    const receiver = ref('');\n    const amount = ref(null);\n\n    const submitTx = async () => {\n      await store.submitTransaction(sender.value, receiver.value, amount.value);\n      alert('Transaction submitted!');\n    };\n\n    const mine = async () => {\n      await store.mineBlock();\n      alert('Block mined!');\n    };\n\n    return {\n      store,\n      sender,\n      receiver,\n      amount,\n      submitTx,\n      mine\n    };\n  }\n};\n</script>\n\n<style scoped>\n.container {\n  max-width: 800px;\n  margin: auto;\n  padding: 2rem;\n  font-family: 'Segoe UI', sans-serif;\n  color: #333;\n}\n\nh1 {\n  text-align: center;\n  color: #4CAF50;\n}\n\n.form {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  margin-bottom: 1rem;\n}\n\n.form input {\n  padding: 0.5rem;\n  font-size: 1rem;\n}\n\nbutton {\n  padding: 0.6rem 1rem;\n  margin-top: 0.5rem;\n  background-color: #4CAF50;\n  color: white;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background-color: #45a049;\n}\n\n.buttons {\n  display: flex;\n  justify-content: space-between;\n  gap: 1rem;\n  margin: 1rem 0;\n}\n\n.lists {\n  display: flex;\n  flex-direction: column;\n  gap: 2rem;\n}\n</style>\n"],"mappings":"AAyBA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,kBAAiB,QAAS,SAAS;AAC5C,OAAOC,UAAS,MAAO,6BAA6B;AACpD,OAAOC,SAAQ,MAAO,4BAA4B;AAElD,eAAe;EACbC,UAAU,EAAE;IAAEF,UAAU;IAAEC;EAAU,CAAC;EACrCE,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,kBAAkB,CAAC,CAAC;IAClC,MAAMM,MAAK,GAAIP,GAAG,CAAC,EAAE,CAAC;IACtB,MAAMQ,QAAO,GAAIR,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMS,MAAK,GAAIT,GAAG,CAAC,IAAI,CAAC;IAExB,MAAMU,QAAO,GAAI,MAAAA,CAAA,KAAY;MAC3B,MAAMJ,KAAK,CAACK,iBAAiB,CAACJ,MAAM,CAACK,KAAK,EAAEJ,QAAQ,CAACI,KAAK,EAAEH,MAAM,CAACG
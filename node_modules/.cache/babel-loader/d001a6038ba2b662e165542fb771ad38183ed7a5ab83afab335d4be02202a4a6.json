{"ast":null,"code":"import { ref } from 'vue';\nimport { useBlockchainStore } from '@/store';\nimport WalletList from '@/components/WalletList.vue';\nimport BlockList from '@/components/BlockList.vue';\nexport default {\n  components: {\n    WalletList,\n    BlockList\n  },\n  setup() {\n    const store = useBlockchainStore();\n    const sender = ref('');\n    const receiver = ref('');\n    const amount = ref(null);\n    const submitTx = async () => {\n      await store.submitTransaction(sender.value, receiver.value, amount.value);\n      alert('Transaction submitted!');\n    };\n    const mine = async () => {\n      await store.mineBlock();\n      alert('Block mined!');\n    };\n    return {\n      store,\n      sender,\n      receiver,\n      amount,\n      submitTx,\n      mine\n    };\n  }\n};","map":{"version":3,"names":["ref","useBlockchainStore","WalletList","BlockList","components","setup","store","sender","receiver","amount","submitTx","submitTransaction","value","alert","mine","mineBlock"],"sources":["/Users/benwo/Desktop/code/my-vue-app/src/views/HomeView.vue"],"sourcesContent":["<template>\n    <div class=\"container\">\n      <h1>🚀 Vue + Go Blockchain Explorer</h1>\n  \n      <form class=\"form\" @submit.prevent=\"submitTx\">\n        <input v-model=\"sender\" placeholder=\"Sender\" />\n        <input v-model=\"receiver\" placeholder=\"Receiver\" />\n        <input v-model.number=\"amount\" type=\"number\" placeholder=\"Amount\" />\n        <button>Submit Transaction</button>\n      </form>\n  \n      <div class=\"buttons\">\n        <button @click=\"mine\">⛏️ Mine Block</button>\n        <button @click=\"store.fetchWallets\">🔄 Refresh Wallets</button>\n        <button @click=\"store.fetchBlockchain\">📜 View Blockchain</button>\n      </div>\n  \n      <transition name=\"fade\">\n        <WalletList :wallets=\"store.wallets\" v-if=\"Object.keys(store.wallets).length\" />\n      </transition>\n  \n      <transition name=\"fade\">\n        <BlockList :blockchain=\"store.blockchain\" v-if=\"store.blockchain.length\" />\n      </transition>\n    </div>\n  </template>\n  \n  <script>\n  import { ref } from 'vue';\n  import { useBlockchainStore } from '@/store';\n  import WalletList from '@/components/WalletList.vue';\n  import BlockList from '@/components/BlockList.vue';\n  \n  export default {\n    components: { WalletList, BlockList },\n    setup() {\n      const store = useBlockchainStore();\n      const sender = ref('');\n      const receiver = ref('');\n      const amount = ref(null);\n  \n      const submitTx = async () => {\n        await store.submitTransaction(sender.value, receiver.value, amount.value);\n        alert('Transaction submitted!');\n      };\n  \n      const mine = async () => {\n        await store.mineBlock();\n        alert('Block mined!');\n      };\n  \n      return {\n        store,\n        sender,\n        receiver,\n        amount,\n        submitTx,\n        mine\n      };\n    }\n  };\n  </script>\n  \n  <style scoped>\n  .container {\n    max-width: 900px;\n    margin: auto;\n    padding: 2rem;\n    font-family: 'Segoe UI', sans-serif;\n    background-color: #121212;\n    color: #f1f1f1;\n  }\n  \n  h1 {\n    text-align: center;\n    color: #00e676;\n  }\n  \n  .form {\n    display: flex;\n    flex-direction: column;\n    gap: 0.75rem;\n    margin-bottom: 1.5rem;\n  }\n  \n  .form input {\n    padding: 0.5rem;\n    font-size: 1rem;\n    background: #1e1e1e;\n    color: #f1f1f1;\n    border: 1px solid #444;\n    border-radius: 6px;\n  }\n  \n  button {\n    padding: 0.6rem 1rem;\n    margin-top: 0.5rem;\n    background-color: #00e676;\n    color: #121212;\n    border: none;\n    border-radius: 6px;\n    cursor: pointer;\n    font-weight: bold;\n    transition: transform 0.2s ease;\n  }\n  \n  button:hover {\n    background-color: #00c853;\n    transform: scale(1.03);\n  }\n  \n  .buttons {\n    display: flex;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: 1rem;\n    margin: 1rem 0 2rem 0;\n  }\n  \n  .fade-enter-active,\n  .fade-leave-active {\n    transition: opacity 0.5s ease;\n  }\n  .fade-enter-from,\n  .fade-leave-to {\n    opacity: 0;\n  }\n  </style>\n  "],"mappings":"AA4BE,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,kBAAiB,QAAS,SAAS;AAC5C,OAAOC,UAAS,MAAO,6BAA6B;AACpD,OAAOC,SAAQ,MAAO,4BAA4B;AAElD,eAAe;EACbC,UAAU,EAAE;IAAEF,UAAU;IAAEC;EAAU,CAAC;EACrCE,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,kBAAkB,CAAC,CAAC;IAClC,MAAMM,MAAK,GAAIP,GAAG,CAAC,EAAE,CAAC;IACtB,MAAMQ,QAAO,GAAIR,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMS,MAAK,GAAIT,GAAG,CAAC,IAAI,CAAC;IAExB,MAAMU,QAAO,GAAI,MAAAA,CAAA,KAAY;MAC3B,MAAMJ,KAAK,CAACK,iBAAiB,CAACJ,MAAM,CAACK,KAAK,EAAEJ,QAAQ,CAACI,KAAK,EAAEH,MAAM,CAACG,KAAK,CAAC;MACzEC,KAAK,CAAC,wBAAwB,CAAC;IACjC,CAAC;IAED,MAAMC,IAAG,GAAI,MAAAA,CAAA,KAAY;MACvB,MAAMR,KAAK,CAACS,SAAS,CAAC,CAAC;MACvBF,KAAK,CAAC,cAAc,CAAC;IACvB,CAAC;IAED,OAAO;MACLP,KAAK;MACLC,MAAM;MACNC,QAAQ;MACRC,MAAM;MACNC,QAAQ;MACRI;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
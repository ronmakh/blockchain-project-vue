{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      newTodo: '',\n      todos: ['Learn Vue', 'Build an app']\n    };\n  },\n  methods: {\n    addTodo() {\n      if (this.newTodo.trim()) {\n        this.todos.push(this.newTodo);\n        this.newTodo = '';\n      }\n    },\n    removeTodo(index) {\n      this.todos.splice(index, 1);\n    }\n  }\n};","map":{"version":3,"names":["data","newTodo","todos","methods","addTodo","trim","push","removeTodo","index","splice"],"sources":["/Users/benwo/Desktop/code/my-vue-app/src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <h2>My Todo List</h2>\n    <input v-model=\"newTodo\" placeholder=\"Add a task\" @keyup.enter=\"addTodo\" />\n    <ul>\n      <li v-for=\"(todo, index) in todos\" :key=\"index\">\n        {{ todo }}\n        <button @click=\"removeTodo(index)\">x</button>\n      </li>\n    </ul>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      newTodo: '',\n      todos: ['Learn Vue', 'Build an app']\n    };\n  },\n  methods: {\n    addTodo() {\n      if (this.newTodo.trim()) {\n        this.todos.push(this.newTodo);\n        this.newTodo = '';\n      }\n    },\n    removeTodo(index) {\n      this.todos.splice(index, 1);\n    }\n  }\n};\n</script>\n\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  padding: 20px;\n}\nbutton {\n  margin-left: 10px;\n}\n</style>\n"],"mappings":";AAcA,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,EAAE;MACXC,KAAK,EAAE,CAAC,WAAW,EAAE,cAAc;IACrC,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,OAAOA,CAAA,EAAG;MACR,IAAI,IAAI,CAACH,OAAO,CAACI,IAAI,CAAC,CAAC,EAAE;QACvB,IAAI,CAACH,KAAK,CAACI,IAAI,CAAC,IAAI,CAACL,OAAO,CAAC;QAC7B,IAAI,CAACA,OAAM,GAAI,EAAE;MACnB;IACF,CAAC;IACDM,UAAUA,CAACC,KAAK,EAAE;MAChB,IAAI,CAACN,KAAK,CAACO,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IAC7B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
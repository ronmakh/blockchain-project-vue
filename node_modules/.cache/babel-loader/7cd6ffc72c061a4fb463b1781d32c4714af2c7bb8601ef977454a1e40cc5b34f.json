{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useBlockchainStore } from '@/store';\nimport WalletList from '@/components/WalletList.vue';\nimport BlockList from '@/components/BlockList.vue';\nexport default {\n  components: {\n    WalletList,\n    BlockList\n  },\n  setup() {\n    const store = useBlockchainStore();\n    const sender = ref('');\n    const receiver = ref('');\n    const amount = ref(null);\n    const walletError = ref('');\n    const blockchainError = ref('');\n    const submitTx = async () => {\n      await store.submitTransaction(sender.value, receiver.value, amount.value);\n      alert('Transaction submitted!');\n    };\n    const mine = async () => {\n      await store.mineBlock();\n      alert('Block mined!');\n      await loadBlockchain();\n    };\n    const loadWallets = async () => {\n      try {\n        await store.fetchWallets();\n        walletError.value = '';\n      } catch (e) {\n        walletError.value = '❌ Failed to load wallets. Please try again later.';\n      }\n    };\n    const loadBlockchain = async () => {\n      try {\n        await store.fetchBlockchain();\n        blockchainError.value = '';\n      } catch (e) {\n        blockchainError.value = '❌ Failed to load blockchain. Please try again later.';\n      }\n    };\n    onMounted(() => {\n      loadWallets();\n      loadBlockchain();\n    });\n    return {\n      store,\n      sender,\n      receiver,\n      amount,\n      submitTx,\n      mine,\n      loadWallets,\n      loadBlockchain,\n      walletError,\n      blockchainError\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","useBlockchainStore","WalletList","BlockList","components","setup","store","sender","receiver","amount","walletError","blockchainError","submitTx","submitTransaction","value","alert","mine","mineBlock","loadBlockchain","loadWallets","fetchWallets","e","fetchBlockchain"],"sources":["/Users/benwo/Desktop/code/my-vue-app/src/views/HomeView.vue"],"sourcesContent":["<template>\n    <div class=\"container\">\n      <!-- Top Input & Actions -->\n      <div class=\"top-section\">\n        <h1>🚀 Vue + Go Blockchain Explorer</h1>\n  \n        <form class=\"form\" @submit.prevent=\"submitTx\">\n            <div class=\"form-group\">\n            <label for=\"sender\">Sender </label>\n            <input id=\"sender\" v-model=\"sender\" placeholder=\"Ben\" />\n            </div>\n\n            <div class=\"form-group\">\n            <label for=\"receiver\">Receiver (e.g., Cam)</label>\n            <input id=\"receiver\" v-model=\"receiver\" placeholder=\"Cam\" />\n            </div>\n\n            <div class=\"form-group\">\n            <label for=\"amount\">BenCoin Amount (e.g., 123)</label>\n            <input id=\"amount\" v-model.number=\"amount\" type=\"number\" placeholder=\"123\" />\n            </div>\n          <button>Submit Transaction</button>\n        </form>\n  \n        <div class=\"buttons\">\n          <button @click=\"mine\">⛏️ Mine Block</button>\n          <button @click=\"loadWallets\">🔄 Refresh Wallets</button>\n          <button @click=\"loadBlockchain\">📜 Reload Blockchain</button>\n        </div>\n      </div>\n  \n      <!-- Bottom Section -->\n      <div class=\"bottom-section\">\n        <!-- Wallets -->\n        <div class=\"panel wallets\">\n          <h2>💼 Wallet Balances</h2>\n          <transition name=\"fade\">\n            <div v-if=\"walletError\" class=\"error\">{{ walletError }}</div>\n            <WalletList v-else :wallets=\"store.wallets\" />\n          </transition>\n        </div>\n  \n        <!-- Blockchain -->\n        <div class=\"panel blockchain\">\n          <h2>⛓️ Blockchain</h2>\n          <transition name=\"fade\">\n            <div v-if=\"blockchainError\" class=\"error\">{{ blockchainError }}</div>\n            <BlockList v-else :blockchain=\"store.blockchain\" />\n          </transition>\n        </div>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  import { ref, onMounted } from 'vue';\n  import { useBlockchainStore } from '@/store';\n  import WalletList from '@/components/WalletList.vue';\n  import BlockList from '@/components/BlockList.vue';\n  \n  export default {\n    components: { WalletList, BlockList },\n    setup() {\n      const store = useBlockchainStore();\n      const sender = ref('');\n      const receiver = ref('');\n      const amount = ref(null);\n  \n      const walletError = ref('');\n      const blockchainError = ref('');\n  \n      const submitTx = async () => {\n        await store.submitTransaction(sender.value, receiver.value, amount.value);\n        alert('Transaction submitted!');\n      };\n  \n      const mine = async () => {\n        await store.mineBlock();\n        alert('Block mined!');\n        await loadBlockchain();\n      };\n  \n      const loadWallets = async () => {\n        try {\n          await store.fetchWallets();\n          walletError.value = '';\n        } catch (e) {\n          walletError.value = '❌ Failed to load wallets. Please try again later.';\n        }\n      };\n  \n      const loadBlockchain = async () => {\n        try {\n          await store.fetchBlockchain();\n          blockchainError.value = '';\n        } catch (e) {\n          blockchainError.value = '❌ Failed to load blockchain. Please try again later.';\n        }\n      };\n  \n      onMounted(() => {\n        loadWallets();\n        loadBlockchain();\n      });\n  \n      return {\n        store,\n        sender,\n        receiver,\n        amount,\n        submitTx,\n        mine,\n        loadWallets,\n        loadBlockchain,\n        walletError,\n        blockchainError\n      };\n    }\n  };\n  </script>\n  \n  <style scoped>\n  .container {\n    display: flex;\n    flex-direction: column;\n    padding: 2rem;\n    font-family: 'Segoe UI', sans-serif;\n    background-color: #121212;\n    color: #f1f1f1;\n    min-height: 100vh;\n  }\n  \n  /* Top input section */\n  .top-section {\n    margin-bottom: 2rem;\n  }\n  \n  h1 {\n    text-align: center;\n    color: #00e676;\n    margin-bottom: 1.5rem;\n  }\n  \n  .form {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.75rem;\n    margin-bottom: 1rem;\n  }\n  \n  .form input {\n    padding: 0.5rem;\n    font-size: 1rem;\n    background: #1e1e1e;\n    color: #f1f1f1;\n    border: 1px solid #444;\n    border-radius: 6px;\n    flex: 1 1 150px;\n  }\n  \n  button {\n    padding: 0.6rem 1rem;\n    background-color: #00e676;\n    color: #121212;\n    border: none;\n    border-radius: 6px;\n    cursor: pointer;\n    font-weight: bold;\n    transition: transform 0.2s ease;\n  }\n  \n  button:hover {\n    background-color: #00c853;\n    transform: scale(1.03);\n  }\n  \n  .buttons {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1rem;\n    margin-top: 1rem;\n  }\n  \n  /* Bottom layout */\n  .bottom-section {\n    display: flex;\n    flex-direction: row;\n    gap: 2rem;\n    flex: 1;\n  }\n  \n  .panel {\n    flex: 1;\n    padding: 1rem;\n    background: #1e1e1e;\n    border-radius: 10px;\n    overflow-y: auto;\n    max-height: 70vh;\n  }\n  \n  h2 {\n    margin-bottom: 1rem;\n    color: #00e676;\n  }\n  \n  .error {\n    color: #ff5252;\n    background: #2e2e2e;\n    padding: 1rem;\n    border-radius: 6px;\n    text-align: center;\n  }\n  \n  .fade-enter-active,\n  .fade-leave-active {\n    transition: opacity 0.5s ease;\n  }\n  .fade-enter-from,\n  .fade-leave-to {\n    opacity: 0;\n  }\n  </style>\n  "],"mappings":"AAuDE,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,kBAAiB,QAAS,SAAS;AAC5C,OAAOC,UAAS,MAAO,6BAA6B;AACpD,OAAOC,SAAQ,MAAO,4BAA4B;AAElD,eAAe;EACbC,UAAU,EAAE;IAAEF,UAAU;IAAEC;EAAU,CAAC;EACrCE,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,kBAAkB,CAAC,CAAC;IAClC,MAAMM,MAAK,GAAIR,GAAG,CAAC,EAAE,CAAC;IACtB,MAAMS,QAAO,GAAIT,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMU,MAAK,GAAIV,GAAG,CAAC,IAAI,CAAC;IAExB,MAAMW,WAAU,GAAIX,GAAG,CAAC,EAAE,CAAC;IAC3B,MAAMY,eAAc,GAAIZ,GAAG,CAAC,EAAE,CAAC;IAE/B,MAAMa,QAAO,GAAI,MAAAA,CAAA,KAAY;MAC3B,MAAMN,KAAK,CAACO,iBAAiB,CAACN,MAAM,CAACO,KAAK,EAAEN,QAAQ,CAACM,KAAK,EAAEL,MAAM,CAACK,KAAK,CAAC;MACzEC,KAAK,CAAC,wBAAwB,CAAC;IACjC,CAAC;IAED,MAAMC,IAAG,GAAI,MAAAA,CAAA,KAAY;MACvB,MAAMV,KAAK,CAACW,SAAS,CAAC,CAAC;MACvBF,KAAK,CAAC,cAAc,CAAC;MACrB,MAAMG,cAAc,CAAC,CAAC;IACxB,CAAC;IAED,MAAMC,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC9B,IAAI;QACF,MAAMb,KAAK,CAACc,YAAY,CAAC,CAAC;QAC1BV,WAAW,CAACI,KAAI,GAAI,EAAE;MACxB,EAAE,OAAOO,CAAC,EAAE;QACVX,WAAW,CAACI,KAAI,GAAI,mDAAmD;MACzE;IACF,CAAC;IAED,MAAMI,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMZ,KAAK,CAACgB,eAAe,CAAC,CAAC;QAC7BX,eAAe,CAACG,KAAI,GAAI,EAAE;MAC5B,EAAE,OAAOO,CAAC,EAAE;QACVV,eAAe,CAACG,KAAI,GAAI,sDAAsD;MAChF;IACF,CAAC;IAEDd,SAAS,CAAC,MAAM;MACdmB,WAAW,CAAC,CAAC;MACbD,cAAc,CAAC,CAAC;IAClB,CAAC,CAAC;IAEF,OAAO;MACLZ,KAAK;MACLC,MAAM;MACNC,QAAQ;MACRC,MAAM;MACNG,QAAQ;MACRI,IAAI;MACJG,WAAW;MACXD,cAAc;MACdR,WAAW;MACXC;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}